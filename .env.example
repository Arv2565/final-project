# Legal Document Ingestion Workflow Environment Variables

# =============================================================================
# QDRANT CONFIGURATION
# =============================================================================

# Qdrant database host (required)
QDRANT_HOST=localhost

# Qdrant database port (required)
QDRANT_PORT=6333

# Qdrant API key (optional, for Qdrant Cloud or secured instances)
# QDRANT_API_KEY=your_api_key_here

# Collection name for storing legal documents
QDRANT_COLLECTION=legal_documents

# Vector size for inLegalBERT embeddings (768 dimensions)
QDRANT_VECTOR_SIZE=768

# Distance metric for similarity search (cosine or euclidean)
QDRANT_DISTANCE_METRIC=cosine

# =============================================================================
# EMBEDDING MODEL CONFIGURATION
# =============================================================================

# inLegalBERT model name (Hugging Face model identifier)
LEGAL_BERT_MODEL=nlpaueb/legal-bert-base-uncased

# Maximum token length for inLegalBERT (512 tokens)
MAX_TOKEN_LENGTH=512

# Batch size for embedding generation
EMBEDDING_BATCH_SIZE=8

# Device for embedding computation (auto, cpu, cuda, mps)
EMBEDDING_DEVICE=auto

# =============================================================================
# DOCUMENT PROCESSING CONFIGURATION
# =============================================================================

# Chunk size in words (should be less than MAX_TOKEN_LENGTH)
CHUNK_SIZE=450

# Overlap between chunks in words
CHUNK_OVERLAP=50

# Minimum chunk size in words
MIN_CHUNK_SIZE=100

# =============================================================================
# SECURITY AND COMPLIANCE CONFIGURATION
# =============================================================================

# Whether to log sensitive data (false for production)
LOG_SENSITIVE_DATA=false

# Data retention period in days (optional)
# DATA_RETENTION_DAYS=365

# Data encryption key (optional, for sensitive data)
# DATA_ENCRYPTION_KEY=your_encryption_key_here

# =============================================================================
# LEGACY AI PROCESSING (for existing aiscript.py functionality)
# =============================================================================

# Gemini API key for existing AI processing features
# GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# PRODUCTION DEPLOYMENT SETTINGS
# =============================================================================

# Application environment (development, staging, production)
APP_ENV=development

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable detailed logging for debugging
DEBUG_MODE=false

# =============================================================================
# EXAMPLE CONFIGURATIONS FOR DIFFERENT ENVIRONMENTS
# =============================================================================

# Local Development:
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# APP_ENV=development
# DEBUG_MODE=true

# Docker Compose:
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333

# Qdrant Cloud:
# QDRANT_HOST=your-cluster.qdrant.io
# QDRANT_PORT=6333
# QDRANT_API_KEY=your_api_key

# Production (Kubernetes/Cloud):
# QDRANT_HOST=qdrant-service
# QDRANT_PORT=6333
# APP_ENV=production
# LOG_LEVEL=WARNING
# LOG_SENSITIVE_DATA=false